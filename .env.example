# Server AI keys (optional; the tool works manually without any of them).
# NEVER commit real values. Set these in Vercel (Production + Preview).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NVIDIA_API_KEY=
# Music recognition (AudD): optional; without it /api/clips/music 503s honestly.
AUDD_API_TOKEN=
# ACRCloud (second fingerprint provider): optional; without both keys
# the ACRCloud adapter never runs. Host defaults to the EU endpoint.
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
# Supabase Auth (Google sign-in): optional; without these, sign-in shows "not configured".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase key (optional; needed only for server-side user lookups).
SUPABASE_SERVICE_ROLE_KEY=
# Paddle billing (merchant of record): optional; without these, checkout 503s honestly.
# PADDLE_ENV: sandbox (default) or live. Price IDs come from the Paddle dashboard — never invented.
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_PRO_PRICE_ID=
# Public site URL used for the sitemap + canonical links.
NEXT_PUBLIC_SITE_URL=https://ai-video-clipper.vercel.app
# Cloudflare R2 storage (resumable uploads): optional; without these,
# /api/uploads/* 503s honestly and the browser upload flow is used.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public R2 hostname (e.g. https://pub-xxx.r2.dev) for share
# embeds; also added to the CSP when R2_CSP_ORIGIN is set (see
# next.config.ts).
R2_PUBLIC_HOST=
R2_CSP_ORIGIN=
# Allow 5 GB multipart uploads (paid-tier gate placeholder until billing
# tier resolution lands). Default (unset) caps uploads at 500 MB.
R2_LARGE_UPLOADS_ENABLED=
# Inngest queue (server jobs): optional; without it the queue reports
# "not configured" and the browser path is used instead.
INNGEST_EVENT_KEY=
# ffmpeg worker (server render): optional; without both, /api/render/jobs
# 503s honestly and browser rendering stays the only path.
WORKER_URL=
WORKER_AUTH_SECRET=
# Speaker diarization provider: optional; no adapter exists yet, so any
# value here still 503s honestly until an adapter lands.
DIARIZATION_PROVIDER=
DIARIZATION_API_KEY=
# Social publishing (ClipForge Phase 3): all optional and OFF by default.
# Token encryption key (REQUIRED for connect/publish): base64 of 32 random
# bytes. Generate with: openssl rand -base64 32. NEVER commit the value.
# KMS replaces this adapter as the production hardening step.
PUBLISH_TOKEN_KEY=
PUBLISH_TOKEN_KEY_ID=env-v1
# Per-platform feature flags (default off) + approval flags (default off).
# Publishing is refused until BOTH are true for that platform.
PUBLISH_YOUTUBE_ENABLED=
YOUTUBE_APP_APPROVED=
PUBLISH_TIKTOK_ENABLED=
TIKTOK_APP_APPROVED=
PUBLISH_INSTAGRAM_ENABLED=
INSTAGRAM_APP_APPROVED=
PUBLISH_FACEBOOK_ENABLED=
FACEBOOK_APP_APPROVED=
PUBLISH_X_ENABLED=
X_APP_APPROVED=
PUBLISH_LINKEDIN_ENABLED=
LINKEDIN_APP_APPROVED=
# OAuth app credentials, one set per platform (from each provider's
# developer console). Redirect URIs default to
# <NEXT_PUBLIC_SITE_URL>/api/accounts/<platform>/callback unless the
# platform-specific redirect env var is set.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Admin console (ClipForge Phase 4): all optional; without a database
# the console shows setup instructions, never invented numbers.
# ADMIN_MFA_ISSUER: name shown in authenticator apps (default ClipForge).
ADMIN_MFA_ISSUER=
# ADMIN_AUDIT_RETENTION_DAYS: audit retention window in days (default 365).
# The purge route deletes only rows older than this window and writes
# its own audit entry. This is the ONLY deletion path for the audit log.
ADMIN_AUDIT_RETENTION_DAYS=
# Anomaly thresholds (defaults 100 events/hour, 5 users/IP).
ADMIN_ALERT_VOLUME_THRESHOLD=
ADMIN_ALERT_IP_USERS_THRESHOLD=
# Alert webhook URLs (optional; without any, dispatch honestly reports
# "not configured" and in-console alerts still work). NEVER commit values.
SLACK_ALERT_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=
EMAIL_ALERT_WEBHOOK_URL=
# ADMIN_SSE_MAX_SECONDS: live-feed stream lifetime in seconds (default 60).
ADMIN_SSE_MAX_SECONDS=
# Reused by Phase 4: PUBLISH_TOKEN_KEY also encrypts MFA secrets and
# signs MFA/view-as session markers (see docs/PHASE4.md).
